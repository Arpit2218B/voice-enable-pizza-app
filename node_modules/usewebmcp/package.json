{
  "name": "usewebmcp",
  "version": "5.1.0",
  "description": "Standalone React hooks for strict core WebMCP tool registration with document.modelContext",
  "keywords": [
    "ai",
    "assistant",
    "browser",
    "hooks",
    "mcp",
    "model-context-protocol",
    "react",
    "react-hooks",
    "tools",
    "usewebmcp"
  ],
  "homepage": "https://docs.mcp-b.ai/packages/usewebmcp/reference",
  "bugs": {
    "url": "https://github.com/WebMCP-org/npm-packages/issues"
  },
  "license": "MIT",
  "author": "WebMCP Team",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WebMCP-org/npm-packages.git",
    "directory": "packages/usewebmcp"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@mcp-b/webmcp-polyfill": "5.1.0",
    "@mcp-b/webmcp-types": "5.1.0"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/react": "^19.2.18",
    "@vitest/coverage-v8": "4.1.8",
    "playwright": "^1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.8.3",
    "vite-plus": "0.1.24",
    "vitest": "npm:@voidzero-dev/vite-plus-test@0.1.24",
    "vitest-browser-react": "^2.2.0",
    "zod": "4.4.3",
    "@mcp-b/global": "5.1.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "vp pack",
    "build:prod": "NODE_ENV=prod vp pack",
    "check": "vp check --fix",
    "clean": "rm -rf dist",
    "format": "vp fmt --write",
    "lint": "vp lint --fix",
    "publish:dry": "pnpm publish --access public --dry-run",
    "publish:npm": "pnpm publish --access public",
    "test": "vp test run",
    "test:watch": "vp test",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.strict-null-checks-false.json --noEmit"
  }
}